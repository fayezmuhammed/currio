# Exchange-rate provider used by the background service worker.
#   open-er-api       — free, no API key (default)
#   exchangerate-api  — keyed v6 API, requires VITE_EXCHANGE_RATE_API_KEY
VITE_EXCHANGE_RATE_PROVIDER=open-er-api

# Only needed for keyed providers. It is bundled into background.js only,
# never into the content script. Anything shipped in an extension can be read
# by someone who unpacks it, so use a restricted key or your own proxy.
VITE_EXCHANGE_RATE_API_KEY=
